/ducklab
/ducklab-engine
/ducklab-desktop
node_modules/
frontend/node_modules/

*.exe
*.test
*.out
coverage.*
frontend/dist/*
!frontend/dist/.gitkeep
/build/
bin/
.DS_Store

# Fixtures must stay pristine: a run executed against them in place mutates
# the working tree and silently invalidates the acceptance criteria.
fixtures/*/.ducklab/
fake-engine-bin
frontend/test-results/
frontend/playwright-report/

# Run records stay local — except the receipt, which is the whole point:
# a stranger cloning this repo must be able to `ducklab proof verify` the
# built-itself claim without trusting anyone. The negation dance is git's
# required incantation for unignoring inside an ignored tree.
.ducklab/runs/*
!.ducklab/runs/*/
.ducklab/runs/*/*
!.ducklab/runs/*/receipt.json
.ducklab/ducklab.db
.ducklab/ducklab.db-wal
.ducklab/ducklab.db-shm
.ducklab/lock

env.test
.env.test.local

# state backups never belong in the tree
.ducklab/*.bak-*
.ducklab/docs/*.bak-*
