  "info": {
    "description": "Local engine API. Loopback only, bearer-token authenticated (07).",
    "title": "ducklab engine",
    "version": "0.3.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/v1/ducklings": {
      "get": {
        "operationId": "DucklingList",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "items": {
                      "items": {
                        "$ref": "#/components/schemas/DucklingDuckling"
                      },
                      "type": "array"
                    },
                    "total": {
                      "type": "integer"
                    }
                  },
                  "required": [
                    "items",
                    "total"
                  ],
                  "type": "object"
                }
              }
            },
            "description": "ok"
          },
          "401": {
            "description": "missing or invalid credentials"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "summary": "List ducklings"
      }
    },
    "/v1/ducklings/{id}/probe": {
      "post": {
        "operationId": "DucklingProbe",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DucklingCapabilities"
                }
              }
            },
            "description": "ok"
          },
          "401": {
            "description": "missing or invalid credentials"
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "summary": "Force a capability re-probe"
      }
    },
    "/v1/ducklings/{id}/test": {
      "post": {
        "operationId": "DucklingTest",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EngineapiducklingTestRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EngineapiducklingTestResponse"
                }
              }
            },
            "description": "ok"
